{
  "openapi": "3.0.0",
  "info": {
    "title": "CTS OCR API",
    "description": "Cheque Truncation System OCR (Optical Character Recognition) - Mobile and Web API Documentation",
    "version": "1.0.0",
    "contact": {
      "name": "CTS Team",
      "email": "support@cts.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5002",
      "description": "Development Server"
    },
    {
      "url": "http://182.76.112.78:91",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Authorization header using the Bearer scheme"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "example": "user123"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "OTPRequest": {
        "type": "object",
        "required": ["employeeid"],
        "properties": {
          "employeeid": {
            "type": "string",
            "example": "EMP001"
          }
        }
      },
      "OTPResponse": {
        "type": "object",
        "properties": {
          "otp": {
            "type": "string"
          },
          "empid": {
            "type": "string"
          }
        }
      },
      "ChequeData": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "integer"
          },
          "branchnationId": {
            "type": "integer"
          },
          "cheque_chequeNo": {
            "type": "string",
            "maxLength": 9
          },
          "cheque_rbiAccNo": {
            "type": "string",
            "maxLength": 8
          },
          "cheque_trCode": {
            "type": "string",
            "maxLength": 5
          },
          "cheque_amt": {
            "type": "number"
          },
          "userId": {
            "type": "string"
          },
          "cheque_micr": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-05-21"
          },
          "scannerId": {
            "type": "string"
          },
          "endNo": {
            "type": "string"
          },
          "frontTiff": {
            "type": "string"
          },
          "backTiff": {
            "type": "string"
          },
          "frontJpeg": {
            "type": "string"
          }
        }
      },
      "BatchCreationRequest": {
        "type": "object",
        "required": [
          "BranchNationID",
          "ClearingID",
          "ChequeCount",
          "TotalAmount",
          "UserID",
          "PresentingDate",
          "BankID",
          "IFSCCode",
          "presentingMICR",
          "scannerID",
          "gridId"
        ],
        "properties": {
          "BranchNationID": {
            "type": "integer",
            "example": 13
          },
          "ClearingID": {
            "type": "string",
            "example": "01"
          },
          "ChequeCount": {
            "type": "integer",
            "example": 4
          },
          "TotalAmount": {
            "type": "number",
            "format": "double",
            "example": 110.50
          },
          "UserID": {
            "type": "string",
            "example": "demo"
          },
          "PresentingDate": {
            "type": "string",
            "format": "date",
            "example": "2026-05-23"
          },
          "BankID": {
            "type": "integer",
            "example": 3
          },
          "IFSCCode": {
            "type": "string",
            "example": "RATN0000050"
          },
          "presentingMICR": {
            "type": "string",
            "example": "411176003"
          },
          "scannerID": {
            "type": "string",
            "example": "70002"
          },
          "is_DepositeSlip": {
            "type": "boolean",
            "example": false
          },
          "is_SubBankMember": {
            "type": "boolean",
            "example": false
          },
          "gridId": {
            "type": "string",
            "example": "01"
          }
        }
      },
      "ReportDateScannerRequest": {
        "type": "object",
        "required": ["date"],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-05-23"
          },
          "scannerId": {
            "type": "string",
            "example": "70002"
          }
        }
      },
      "ReportDateRequest": {
        "type": "object",
        "required": ["date"],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-05-23"
          }
        }
      },
      "RejectionStatusRequest": {
        "type": "object",
        "required": ["presentingMICR", "scannerID", "presentaionDate"],
        "properties": {
          "presentingMICR": {
            "type": "string",
            "example": "411176003"
          },
          "scannerID": {
            "type": "string",
            "example": "70002"
          },
          "presentaionDate": {
            "type": "string",
            "format": "date",
            "example": "2026-05-23"
          }
        }
      },
      "NPCIStatusRequest": {
        "type": "object",
        "required": ["date"],
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-05-23"
          },
          "scannerId": {
            "type": "string",
            "example": "70002"
          }
        }
      },
      "ReportRequest": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "branchId": {
            "type": "integer"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Get OTP for Employee",
        "description": "Fetches OTP details for a given employee ID from Oracle database",
        "operationId": "getOTP",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OTPRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OTPResponse"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "x-status": "ACTIVE"
      }
    },
    "/cts/loginUser": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User Login",
        "description": "Authenticate user with username and password",
        "operationId": "loginUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        },
        "x-status": "ACTIVE"
      }
    },
    "/cts/logoutUser": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User Logout",
        "description": "Logout authenticated user",
        "operationId": "logoutUser",
        "responses": {
          "200": {
            "description": "Logout successful"
          }
        },
        "x-status": "ACTIVE"
      }
    },
    "/cts/encrypt": {
      "post": {
        "tags": ["Security"],
        "summary": "Encrypt Password",
        "description": "Encrypt a password string",
        "operationId": "encryptPass",
        "security": [],
